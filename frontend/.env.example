# ==============================================================================
# SAR-Vision Frontend Environment Configuration Template
#
# Copy this file to .env before deploying:
#   cp .env.example .env
#
# WHEN IS THIS NEEDED?
# - In local development: Leave unset or empty. The Vite development server
#   automatically proxies '/api' and '/health' to http://127.0.0.1:8000 without CORS.
# - In production / deployed setup: When the frontend is hosted on a separate origin
#   from the backend (e.g., Vercel, Netlify, CloudFront) talking to an external
#   backend API, set this variable to the backend API base URL (including the /api path).
# ==============================================================================

# Backend API base URL.
# In local development, leave unset or set to '/api'.
# In cross-origin deployments, set to full URL:
# VITE_API_BASE_URL=https://api.sar-vision.example.com/api
VITE_API_BASE_URL=/api
