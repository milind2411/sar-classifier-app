# ==============================================================================
# SAR-Vision Backend Environment Configuration Template
#
# Copy this file to .env before deploying:
#   cp .env.example .env
#
# IMPORTANT PRE-DEPLOYMENT CHECKLIST:
# Before any public deployment, ALLOWED_ORIGINS MUST be set to your real deployed
# frontend domain(s) (e.g. https://sar-vision.example.com).
# In local development, leaving this unset defaults to standard localhost ports:
# http://localhost:5173 (Vite default) and http://localhost:3000.
# ==============================================================================

# Comma-separated list of allowed CORS origins.
# DO NOT set this to '*' in public deployment.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
