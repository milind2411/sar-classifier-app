# ==============================================================================
# SAR-Vision Backend Environment Configuration Template
#
# Copy this file to .env before deploying:
#   cp .env.example .env
#
# IMPORTANT PRE-DEPLOYMENT CHECKLIST:
# Before any public deployment, ALLOWED_ORIGINS MUST be set to your real deployed
# frontend domain(s) (e.g. https://sar-vision.example.com).
# In local development, leaving this unset defaults to standard localhost ports:
# http://localhost:5173 (Vite default) and http://localhost:3000.
# ==============================================================================

# Comma-separated list of allowed CORS origins.
# DO NOT set this to '*' in public deployment.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Structured stdout logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL).
# Defaults to INFO if unset.
LOG_LEVEL=INFO

# Path to the SQLite prediction history database.
# Defaults to backend/data/predictions.db if unset.
# In containerized/Docker environments, ensure this path is mounted on a persistent volume
# (e.g. /app/data/predictions.db) to prevent data loss across container restarts.
PREDICTIONS_DB_PATH=data/predictions.db

# Prediction history tracking and retrieval toggle (true/false).
# Defaults to true for local development.
# NOTE: In public demonstrations or multi-tenant deployments, set this to false to disable
# shared prediction history logging and return 404 on GET /api/history.
HISTORY_ENABLED=true

